# Backend
APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://weixue:weixue@localhost:5432/weixue
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=480
AI_PROVIDER=deepseek
# DeepSeek credentials are backend-only; never expose them with a VITE_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_WORKER_ENABLED=true
AI_WORKER_POLL_SECONDS=1
AI_JOB_LEASE_SECONDS=90
AI_JOB_MAX_ATTEMPTS=3

# Frontend (optional; Vite proxy is used by default)
VITE_API_BASE_URL=/api/v1
